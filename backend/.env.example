# ─────────────────────────────────────────────────────────────
# CONFIGURACIÓN DEL ENTORNO BACKEND (backend/.env)
# ─────────────────────────────────────────────────────────────
# Copia este archivo a backend/.env y ajusta los valores locales.
# NUNCA compartas ni subas backend/.env al repositorio.

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-desarrollo-soporte-clave-secreta-cambiar-en-prod-12345
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventario_dev

# CORS (Frontend Vite en desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MFA / TOTP
MFA_ISSUER=InventarioSoporte
# Para generar una clave vÃ¡lida de cifrado Fernet (32 bytes base64 url-safe), ejecuta:
# backend\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=PONER_AQUI_LA_CLAVE_FERNET_GENERADA
MFA_ENFORCED=True

# Confianza en cabecera X-Forwarded-For para obtener IP de auditorÃ­a.
# True solo detrÃ¡s de proxy confiable; por defecto False (usa REMOTE_ADDR).
TRUST_X_FORWARDED_FOR=False

# Semilla de desarrollo (comando seed_usuarios_dev)
SEED_DEV_PASSWORD=DevPassword123!
